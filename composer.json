{
    "name": "astrotomic/airchive",
    "description": "",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "astrotomic/php-unavatar": "^0.3",
        "laravel/fortify": "^1.38",
        "laravel/framework": "^13.26.1",
        "laravel/passkeys": "^0.2.1",
        "livewire/livewire": "^4.4.1",
        "spatie/emoji": "^4.1.3",
        "ua-parser/uap-php": "^3.10",
        "zenstruck/bytes": "^1.1"
    },
    "require-dev": {
        "astrotomic/phpunit-assertions": "^0.14.0",
        "barryvdh/laravel-ide-helper": "^3.7",
        "ekino/phpstan-banned-code": "^3.2",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30.5",
        "league/iso3166": "^4.4",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^13.3.1",
        "spaze/phpstan-disallowed-calls": "^4.14.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Astrotomic\\PHPStan\\": "phpstan/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "composer-normalize": {
            "indent-size": 4,
            "indent-style": "space"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "fix": "@php vendor/bin/pint",
        "fix-dirty": "@php vendor/bin/pint --dirty",
        "ide": [
            "@php artisan ide-helper:models --write --dir=app/Models --ansi --reset --no-interaction --quiet",
            "@composer fix"
        ],
        "normalize": "echo 'composer global require ergebnis/composer-normalize'",
        "phpstan": "@php vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan-baseline": "@php vendor/bin/phpstan analyse --memory-limit=2G --allow-empty-baseline --generate-baseline",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "thanks": "echo 'composer global require symfony/thanks'"
    },
    "$schema": "https://getcomposer.org/schema.json"
}
